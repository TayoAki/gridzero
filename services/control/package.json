{
  "name": "@gridzero/control",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.ts",
    "start": "node src/server.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "test": "node --test --env-file-if-exists=.env test/*.test.ts"
  },
  "dependencies": {
    "@hono/node-server": "2.1.5",
    "@sentry/node": "11.11.0",
    "better-auth": "1.7.14",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.14",
    "postgres": "3.4.9"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "drizzle-kit": "0.31.11",
    "typescript": "7.0.2"
  }
}
