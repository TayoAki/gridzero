DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54329/postgres
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:5173
# Shared with wbhost; any random string locally.
WB_TOKEN_SECRET=
WBHOST_PUBLIC_URL=ws://localhost:8790
# Set to 1 when DATABASE_URL points at local PGlite (single session).
DB_POOL_MAX=1
# GridZero's own AI key (OpenRouter), so people without a key can use agents. Leave unset to require everyone's own key.
# OPENROUTER_API_KEY=
# PLATFORM_AI_USER_CAP_USD=2
# PLATFORM_AI_TOTAL_CAP_USD=100
